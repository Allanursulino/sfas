        if type(PlayerState.Data) == "table" then
            return PlayerState.Data
        elseif type(PlayerState.GetData) == "function" then
            local ok, res = pcall(function() return PlayerState:GetData() end)
            if ok and type(res) == "table" then return res end
        elseif type(PlayerState.Get) == "function" then
            local ok, res = pcall(function() return PlayerState:Get() end)
            if ok and type(res) == "table" then return res end
        else
            for _, v in pairs(PlayerState) do
                if type(v) == "table" and (v.Cash ~= nil or v.Power ~= nil or v.Upgrades ~= nil or v.Rebirths ~= nil) then
                    return v
                end
            end
        end
    end
    return nil
end

