local function GetSortedPads()
    local pads = {}
    local seenIds = {}

    local folder = GetEnemyPadsFolder()
    if folder then
        for idx, pad in ipairs(folder:GetChildren()) do
            local id = tonumber(pad.Name) or tonumber(pad:GetAttribute("PadId")) or idx
            local cf = pad:GetAttribute("PadCFrame")
            if typeof(cf) ~= "CFrame" then
                if pad:IsA("BasePart") then
                    cf = pad.CFrame
                elseif pad:IsA("Model") then
                    local ok, pivot = pcall(function() return pad:GetPivot() end)
                    if ok and typeof(pivot) == "CFrame" then
                        cf = pivot
                    end
                else
                    local part = pad:FindFirstChildWhichIsA("BasePart", true)
                    if part then cf = part.CFrame end
                end
            end
            if typeof(cf) == "CFrame" then
                seenIds[id] = true
                table.insert(pads, { id = id, cframe = cf, instance = pad })
            end
        end
    end

    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        for idx, enemy in ipairs(enemiesFolder:GetChildren()) do
            local padId = tonumber(enemy:GetAttribute("PadId")) or (1000 + idx)
            if not seenIds[padId] then
                local root = enemy:FindFirstChild("HumanoidRootPart")
                    or enemy.PrimaryPart
                    or enemy:FindFirstChildWhichIsA("BasePart", true)
                if root then
                    seenIds[padId] = true
                    table.insert(pads, { id = padId, cframe = root.CFrame, instance = enemy })
                end
            end
        end
    end

    if #pads == 0 then
        local world = GetCurrentWorld()
        local zoneList = (world == 2) and WORLD_2_ZONES or WORLD_1_ZONES
        for idx, zName in ipairs(zoneList) do
            local pos = ZONE_POSITIONS[zName]
            if pos then
                table.insert(pads, { id = idx, cframe = CFrame.new(pos), instance = nil })
            end
        end
    end

    table.sort(pads, function(a, b) return (a.id or 9999) < (b.id or 9999) end)
    return pads
end

local function GetActiveEnemies(filterZones)
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return {} end

    local zoneLookup = nil
    if filterZones and #filterZones > 0 then
        zoneLookup = {}
        for _, z in ipairs(filterZones) do
            zoneLookup[z] = true
        end
    end

    local results = {}
    for _, enemy in ipairs(folder:GetChildren()) do
        local padId = enemy:GetAttribute("PadId")
        local isBossAttr = enemy:GetAttribute("Boss")
        local dbInfo = ENEMY_DATABASE[enemy.Name]
        local isBoss = (isBossAttr == true) or (dbInfo and dbInfo.isBoss == true)

        if (not isBoss) or State.KillBosses then
            local zoneMatch = true
            if zoneLookup and dbInfo and dbInfo.loc then
                zoneMatch = (zoneLookup[dbInfo.loc] == true)
            end
            if zoneMatch then
                local root = enemy:FindFirstChild("HumanoidRootPart")
                    or enemy.PrimaryPart
                    or enemy:FindFirstChildWhichIsA("BasePart", true)
                local hum = enemy:FindFirstChildOfClass("Humanoid")
                local alive = (not hum) or (hum.Health > 0)
                if alive then
                    table.insert(results, {
                        model  = enemy,
                        padId  = padId,
                        isBoss = isBoss,
                        root   = root,
                        loc    = dbInfo and dbInfo.loc or nil,
                    })
                end
            end
        end
    end

    table.sort(results, function(a, b)
        return (tonumber(a.padId) or 9999) < (tonumber(b.padId) or 9999)
    end)
    return results
end

