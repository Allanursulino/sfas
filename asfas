local function SafeRequire(pathTbl)
    local curr = ReplicatedStorage
    for _, seg in ipairs(pathTbl) do
        if not curr then
            curr = nil
            break
        end
        curr = curr:FindFirstChild(seg)
    end
    if curr and curr:IsA("ModuleScript") then
        local ok, mod = pcall(require, curr)
        if ok then return mod end
    end
    local targetName = pathTbl[#pathTbl]
    if targetName then
        for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
            if desc:IsA("ModuleScript") and desc.Name == targetName then
                local ok, mod = pcall(require, desc)
                if ok then return mod end
            end
        end
    end
    return nil
end

