local function GetCosmeticItemsForKind(kindName, scoreFn)
    local results = {}
    local seen = {}
    local lowerKind = string.lower(kindName)

    local function AddCandidate(id, itTbl, fallbackIdx)
        if type(id) ~= "string" or id == "" or seen[id] then return end
        if id == "Items" or id == "Kinds" or id == "Owned" or id == "Equipped" then return end
        local robuxOnly = false
        local price = 0
        local world = nil
        local score = (fallbackIdx or (#results + 1)) * 1000

        if type(itTbl) == "table" then
            robuxOnly = (itTbl.RobuxOnly == true) or (itTbl.Robux ~= nil and tonumber(itTbl.Robux) > 0) or (itTbl.ProductId ~= nil)
            price = tonumber(itTbl.Price or itTbl.Cost or itTbl.Cash or itTbl.Coins) or 0
            world = tonumber(itTbl.World)
            score = scoreFn(itTbl, fallbackIdx or (#results + 1))
        end

        if not robuxOnly then
            seen[id] = true
            table.insert(results, {
                id    = id,
                price = price,
                world = world,
                score = score,
            })
        end
    end

    -- 1. Search CosmeticConfig and ALL required rules modules in ReplicatedStorage
    local modulesToScan = {}
    if type(CosmeticConfig) == "table" then
        table.insert(modulesToScan, CosmeticConfig)
    end
    for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
        if desc:IsA("ModuleScript") then
            local mn = string.lower(desc.Name)
            if string.find(mn, "cosmetic") or string.find(mn, lowerKind) then
                local ok, mod = pcall(require, desc)
                if ok and type(mod) == "table" and mod ~= CosmeticConfig then
                    table.insert(modulesToScan, mod)
                end
            end
        end
    end

    local function ScanConfigTable(tbl)
        if type(tbl) ~= "table" then return end
        local kindsTbl = tbl.Kinds or tbl
        for k, v in pairs(kindsTbl) do
            if type(k) == "string" and string.find(string.lower(k), lowerKind) and type(v) == "table" then
                local rawItems = v.Items or v.List or v
                if type(rawItems) == "table" then
                    for idxKey, it in pairs(rawItems) do
                        if type(it) == "table" then
                            local itemId = it.Id or it.ID or it.Name or (type(idxKey) == "string" and idxKey) or nil
                            AddCandidate(itemId, it, tonumber(idxKey) or (#results + 1))
                        elseif type(it) == "string" then
                            AddCandidate(it, nil, tonumber(idxKey) or (#results + 1))
                        end
                    end
                end
            end
        end
    end

    for _, mod in ipairs(modulesToScan) do
        pcall(ScanConfigTable, mod)
    end

    -- 2. Scan ReplicatedStorage asset folders (Uses GetAttribute safely so Roblox Trail.Speed property doesn't error!)
    for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
        if desc:IsA("Folder") or desc:IsA("Configuration") then
            local n = string.lower(desc.Name)
            if n == lowerKind or n == (lowerKind .. "s") then
                for idx, child in ipairs(desc:GetChildren()) do
                    local priceAttr = tonumber(child:GetAttribute("Price") or child:GetAttribute("Cost")) or 0
                    local statAttr  = tonumber(
                        child:GetAttribute("Speed")
                        or child:GetAttribute("WalkSpeed")
                        or child:GetAttribute("Multiplier")
                        or child:GetAttribute("Boost")
                        or child:GetAttribute("Order")
                    ) or idx
                    AddCandidate(child.Name, {
                        Id         = child.Name,
                        Price      = priceAttr,
                        World      = tonumber(child:GetAttribute("World")),
                        Speed      = statAttr,
                        Multiplier = statAttr,
                        Order      = tonumber(child:GetAttribute("Order")) or idx,
                    }, idx)
                end
            end
        end
    end

    -- 3. Also append fallback progression names so even if items aren't in a local folder, every known Trail/Aura ID is covered
    local fallback = (kindName == "Aura") and FALLBACK_AURA_LIST or FALLBACK_TRAIL_LIST
    for idx, name in ipairs(fallback) do
        if not seen[name] then
            AddCandidate(name, {
                Id         = name,
                Price      = 0,
                Speed      = idx,
                Multiplier = idx,
                Order      = idx,
            }, idx)
        end
    end

    table.sort(results, function(a, b) return a.score < b.score end)
    return results
end

local function ProcessCosmeticKind(kindName, scoreFn)
    if not BuyCosmeticRemote then BuyCosmeticRemote = GetRemote("BuyCosmetic") end
    if not EquipCosmeticRemote then EquipCosmeticRemote = GetRemote("EquipCosmetic") end

    local d = GetPlayerData()
    local cash = GetPlayerCash()
    local world = GetCurrentWorld()
    local items = GetCosmeticItemsForKind(kindName, scoreFn)

    -- Locate the player's owned table & currently equipped ID for this kind
    local ownedTbl = nil
    local equippedId = nil
    if type(d) == "table" then
        if CosmeticConfig and type(CosmeticConfig.Kinds) == "table" then
            local kCfg = CosmeticConfig.Kinds[kindName] or CosmeticConfig.Kinds[kindName .. "s"]
            if type(kCfg) == "table" then
                if kCfg.Owned and type(d[kCfg.Owned]) == "table" then ownedTbl = d[kCfg.Owned] end
                if kCfg.Equipped and d[kCfg.Equipped] ~= nil then equippedId = d[kCfg.Equipped] end
            end
        end
        ownedTbl = ownedTbl
            or d[kindName .. "s"]
            or d["Owned" .. kindName .. "s"]
            or d[kindName]
            or (type(d.Cosmetics) == "table" and (d.Cosmetics[kindName] or d.Cosmetics[kindName .. "s"]))
            or (type(d.OwnedCosmetics) == "table" and (d.OwnedCosmetics[kindName] or d.OwnedCosmetics[kindName .. "s"]))
        if type(ownedTbl) ~= "table" then
            ownedTbl = nil
        end

        equippedId = equippedId
            or d["Equipped" .. kindName]
            or d["Selected" .. kindName]
            or (type(d[kindName]) == "string" and d[kindName])
            or (type(d.EquippedCosmetics) == "table" and d.EquippedCosmetics[kindName])
    end

    equippedId = equippedId
        or LocalPlayer:GetAttribute("Equipped" .. kindName)
        or LocalPlayer:GetAttribute(kindName)

    local function IsOwned(id)
        if type(ownedTbl) ~= "table" then return false end
        if ownedTbl[id] == true or (type(ownedTbl[id]) == "number" and ownedTbl[id] > 0) then return true end
        for k, v in pairs(ownedTbl) do
            if v == id or (k == id and v) then return true end
        end
        return false
    end

    local newlyBoughtBestId = nil

    -- Step 1: Buy all affordable unowned items in ascending order using:
    -- ReplicatedStorage.Remotes.BuyCosmetic:InvokeServer(kindName, itemId)
    for _, entry in ipairs(items) do
        if (kindName == "Aura" and not State.AutoBestAura) or (kindName == "Trail" and not State.AutoFastestTrail) then
            return
        end
        local worldOk = (entry.world == nil) or (entry.world <= world)
        local alreadyOwned = IsOwned(entry.id)
        local canAfford = (cash == nil) or (entry.price <= 0) or (cash >= entry.price)

        if worldOk and not alreadyOwned and canAfford and BuyCosmeticRemote then
            local ok, res = pcall(function()
                return BuyCosmeticRemote:InvokeServer(kindName, entry.id)
            end)
            if ok and (res == true or (type(res) == "table" and res.Success ~= false)) then
                newlyBoughtBestId = entry.id
                if type(ownedTbl) == "table" then
                    ownedTbl[entry.id] = true
                end
            end
            task.wait(0.04)
            d = GetPlayerData() or d
            cash = GetPlayerCash()
        end
    end

    -- Step 2: Equip the highest-tier owned item
    if EquipCosmeticRemote then
        -- Refresh ownedTbl after purchases
        if type(d) == "table" then
            if CosmeticConfig and type(CosmeticConfig.Kinds) == "table" then
                local kCfg = CosmeticConfig.Kinds[kindName] or CosmeticConfig.Kinds[kindName .. "s"]
                if type(kCfg) == "table" and kCfg.Owned and type(d[kCfg.Owned]) == "table" then
                    ownedTbl = d[kCfg.Owned]
                end
            end
            ownedTbl = ownedTbl or (type(d[kindName .. "s"]) == "table" and d[kindName .. "s"]) or (type(d["Owned" .. kindName .. "s"]) == "table" and d["Owned" .. kindName .. "s"])
        end

        local targetEquipId = nil
        if type(ownedTbl) == "table" and next(ownedTbl) ~= nil then
            for i = #items, 1, -1 do
                local entry = items[i]
                if IsOwned(entry.id) then
                    targetEquipId = entry.id
                    break
                end
            end
        end

        if not targetEquipId and newlyBoughtBestId then
            targetEquipId = newlyBoughtBestId
        end

        if targetEquipId then
            if targetEquipId ~= equippedId then
                pcall(function()
                    if EquipCosmeticRemote:IsA("RemoteFunction") then
                        EquipCosmeticRemote:InvokeServer(kindName, targetEquipId)
                    else
                        EquipCosmeticRemote:FireServer(kindName, targetEquipId)
                    end
                end)
            end
        else
            -- Fallback if owned list isn't readable: equip in ascending order so the highest owned Trail/Aura remains active
            for _, entry in ipairs(items) do
                if (kindName == "Aura" and not State.AutoBestAura) or (kindName == "Trail" and not State.AutoFastestTrail) then
                    return
                end
                local worldOk = (entry.world == nil) or (entry.world <= world)
                local priceOk = (cash == nil) or (entry.price <= 0) or (entry.price <= (cash * 20 + 1e6))
                if worldOk and priceOk then
                    pcall(function()
                        if EquipCosmeticRemote:IsA("RemoteFunction") then
                            EquipCosmeticRemote:InvokeServer(kindName, entry.id)
                        else
                            EquipCosmeticRemote:FireServer(kindName, entry.id)
                        end
                    end)
                    task.wait(0.03)
                end
            end
        end
    end
end

