local function DestroyGemsPageInstances(win)
    pcall(function()
        if win and win.GemsTab then
            local gt = win.GemsTab
            win.GemsTab = nil
            if win.Tabs and gt.Name then
                win.Tabs[gt.Name] = nil
            end
            for _, v in pairs(gt) do
                if typeof(v) == "Instance" then
                    pcall(function() v:Destroy() end)
                end
            end
        end

        local roots = { get_ui_parent(), CoreGui, LocalPlayer:FindFirstChild("PlayerGui") }
        for _, root in ipairs(roots) do
            if root then
                for _, desc in ipairs(root:GetDescendants()) do
                    if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                        local t = desc.Text
                        if t == "Break & Gems" or t == "Auto Collect Gems & Break" then
                            local curr = desc.Parent
                            while curr and curr.Parent do
                                if curr:IsA("ScrollingFrame") or (curr.Parent:IsA("Frame") and string.find(string.lower(curr.Parent.Name), "page")) then
                                    pcall(function() curr:Destroy() end)
                                    break
                                end
                                curr = curr.Parent
                            end
                            if desc and desc.Parent then
                                pcall(function() desc.Parent:Destroy() end)
                            end
                        elseif t == "Gems" then
                            desc.Text = "Combat & Farm"
                        end
                    end
                end
            end
        end
    end)
end

