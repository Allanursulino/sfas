local function GetLocalPlayerPlotAndPrompt()
    if State.CachedBestPrompt and State.CachedBestPrompt.Parent then
        return State.CachedPlot, State.CachedBestPrompt
    end

    local map = workspace:FindFirstChild("Map")
    local bases = (map and map:FindFirstChild("Bases")) or workspace:FindFirstChild("Bases", true)
    if not bases then return nil, nil end

    local myPlot = nil
    local myUserId = LocalPlayer.UserId

    for _, plot in ipairs(bases:GetChildren()) do
        local ownerAttr = plot:GetAttribute("Owner")
        if ownerAttr ~= nil and (tonumber(ownerAttr) == myUserId or tostring(ownerAttr) == tostring(myUserId) or ownerAttr == LocalPlayer.Name) then
            myPlot = plot
            break
        end
    end

    if not myPlot then
        local baseSpawn = LocalPlayer:GetAttribute("BaseSpawn")
        if typeof(baseSpawn) == "CFrame" then
